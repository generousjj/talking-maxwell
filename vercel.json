{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@6.53.0",
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "{static/**,config.yaml}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
