{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "{static/**,config.yaml}"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/api",
      "transforms": [
        {
          "type": "request.query",
          "op": "set",
          "target": { "key": "__path" },
          "args": "/$1"
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-vercel-original-path" },
          "args": "/$1"
        }
      ]
    }
  ]
}
