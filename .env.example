# Copy this file to `.env` and fill in any secrets you want loaded at startup.
# Values already present in your shell environment are NOT overridden.

# =========================================================
# Shared
# =========================================================

# Required for OpenAI providers (STT/LLM/TTS). Leave unset to force stub fallback.
OPENAI_API_KEY=

# Optional: override the LLM/TTS model defaults without editing config.yaml.
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# =========================================================
# Hosted browser mode only (python -m app.web_app)
# =========================================================
# These vars are ignored by the current local app (`python -m app.webapp`).

# PREFERRED: a PBKDF2-SHA256 hash. Generate with:
#   python -m app.web_auth hash 'your-password'
# MAXWELL_WEB_PASSWORD_HASH=pbkdf2_sha256$200000$...

# Fallback for local development ONLY — plaintext comparison.
# MAXWELL_WEB_PASSWORD=change-me

# Random secret used to sign session cookies. Keep stable across
# restarts so operators don't get logged out. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# SESSION_SECRET=

# Optional: lock state-changing API calls to a single origin (CSRF
# defense). Defaults to the request's own scheme+host.
# MAXWELL_ALLOWED_ORIGIN=https://maxwell.example.com

# Set to 1 ONLY when running behind a trusted reverse proxy so
# X-Forwarded-For is used for rate-limit keying.
# MAXWELL_TRUST_FORWARDED_FOR=1

# Set to 1 when testing over plain HTTP to disable the Secure cookie
# flag. NEVER set this in production.
# MAXWELL_WEB_INSECURE_COOKIE=1
